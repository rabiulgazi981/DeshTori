{
  "name": "deshtori",
  "private": true,
  "version": "0.1.0",
  "description": "DeshTori Door To Door – China (1688/Taobao) to Bangladesh sourcing platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @deshtori/api dev",
    "dev:web": "pnpm --filter @deshtori/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:dashboard": "pnpm --filter @deshtori/api build && node --test tests/dashboard-*.test.cjs",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @deshtori/api prisma:migrate",
    "db:seed": "pnpm --filter @deshtori/api prisma:seed",
    "db:push": "pnpm --filter @deshtori/api exec prisma db push"
  }
}
