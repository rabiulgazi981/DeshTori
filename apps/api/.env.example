# ── Server ──
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# ── Database / cache ──
DATABASE_URL=postgresql://deshtori:deshtori@localhost:5432/deshtori?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=30d
# never set true in production: prints OTP codes to the API console instead of sending SMS
OTP_DEV_ECHO=true

# ── SMS gateway (keys stay ONLY on the server) ──
SMS_PROVIDER=console          # console (dev: prints OTP) | alpha (Alpha SMS, sms.net.bd) | http (generic GET gateway)
SMS_API_KEY=                  # Alpha SMS API key — server .env only
SMS_SENDER_ID=                # leave empty until Alpha approves a Sender ID (e.g. DeshTori)
SMS_HTTP_URL=                 # only for SMS_PROVIDER=http: https://api.provider.com/send?api_key={key}&to={to}&msg={msg}&sender={sender}

# ── Product data provider (1688 / Taobao) ──
PRODUCT_PROVIDER=mock         # mock | alibaba-1688 (1688, tested OK) | taobao-datahub (search only)
RAPIDAPI_KEY=                 # for taobao-datahub — server .env only, never commit
RAPIDAPI_HOST=taobao-datahub.p.rapidapi.com
RAPIDAPI_1688_HOST=alibaba-1688-api.p.rapidapi.com
RAPIDAPI_LOCALE=               # empty = Chinese titles; try en_US for English titles if the plan supports it
PRODUCT_API_URL=
PRODUCT_API_KEY=
PRODUCT_CACHE_MINUTES=60

# ── Seed (first owner account) ──
SEED_OWNER_PHONE=+8801938273878
SEED_OWNER_PASSWORD=

# ── Public URLs (used in SMS links, payment callbacks, upload links) ──
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api
UPLOAD_DIR=./uploads

# ── Payment gateways (keys stay ONLY on the server) ──
GATEWAY_MOCK=true             # development only: instant fake payment button
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=

# Encrypt dashboard credentials (32+ random characters). Keep this key stable and backed up.
INTEGRATIONS_ENCRYPTION_KEY=
